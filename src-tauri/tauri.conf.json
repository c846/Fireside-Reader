{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fireside Reader",
  "version": "0.1.0",
  "identifier": "com.fireside.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fireside Reader",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Fireside Reader",
    "category": "Utility",
    "shortDescription": "A local ePub and text reader",
    "longDescription": "Fireside Reader keeps your ePub and text books in a private library on your computer, with bookmarks, themes and a distraction-free reading view.",
    "copyright": "",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
